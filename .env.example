# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (never prefix with NEXT_PUBLIC_). Used by the safety alert job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=make-up-a-long-random-string

# Twilio, for safety texts. Leave blank until you're ready; alerts are logged instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TIMEZONE=America/Los_Angeles
CHECKIN_GRACE_MINUTES=30
